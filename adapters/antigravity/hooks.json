{
  "agent-workflow-git-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"{{HOOKS_DIR}}\\git-guard.ps1\"",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "agent-workflow-quality-gate": {
    "Stop": [
      {
        "type": "command",
        "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"{{HOOKS_DIR}}\\quality-gate.ps1\"",
        "timeout": 15
      }
    ]
  }
}
