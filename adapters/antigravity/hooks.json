{
  "agent-workflow-memory-context": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "\"{{NODE_EXE}}\" \"{{RUNTIME_DIR}}\\agent-workflow.mjs\" memory-context --platform Antigravity --auto",
        "timeout": 15
      }
    ]
  },
  "agent-workflow-git-guard": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"{{NODE_EXE}}\" \"{{RUNTIME_DIR}}\\agent-workflow-hook.mjs\" git-guard --platform Antigravity",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
