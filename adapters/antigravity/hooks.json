{
  "agent-workflow-memory-context": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "\"{{NODE_EXE}}\" \"{{RUNTIME_DIR}}\\agent-workflow.mjs\" memory-context --platform Antigravity --state-root \"{{STATE_ROOT}}\" --auto --event SessionStart",
        "timeout": 15
      }
    ]
  },
  "agent-workflow-session-cleanup": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "\"{{NODE_EXE}}\" \"{{RUNTIME_DIR}}\\agent-workflow-hook.mjs\" session-start --platform Antigravity --state-root \"{{STATE_ROOT}}\"",
        "timeout": 15
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "\"{{NODE_EXE}}\" \"{{RUNTIME_DIR}}\\agent-workflow-hook.mjs\" session-cleanup --platform Antigravity --state-root \"{{STATE_ROOT}}\"",
        "timeout": 15
      }
    ]
  },
  "agent-workflow-locale-context": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "\"{{NODE_EXE}}\" \"{{RUNTIME_DIR}}\\agent-workflow-hook.mjs\" locale-context --platform Antigravity --state-root \"{{STATE_ROOT}}\"",
        "timeout": 15
      }
    ]
  }
}
