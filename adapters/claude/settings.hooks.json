{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"{{NODE_EXE}}\" \"{{RUNTIME_DIR}}\\agent-workflow.mjs\" memory-context --platform Claude --auto",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"{{NODE_EXE}}\" \"{{RUNTIME_DIR}}\\agent-workflow-hook.mjs\" locale-reminder --platform Claude",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"{{NODE_EXE}}\" \"{{RUNTIME_DIR}}\\agent-workflow-hook.mjs\" locale-lint --platform Claude",
            "timeout": 15
          },
          {
            "type": "agent",
            "timeout": 60,
            "prompt": "[agent-workflow managed: clean-comments]\n任務準備結束前執行 clean-comments 最終檢查。先讀取目前安裝的 clean-comments/SKILL.md 全文。接著只檢查目前工作樹本次變更：用 git diff --cached 取得 staged diff、git diff 取得 unstaged diff，並用 git ls-files --others --exclude-standard 找出未追蹤檔案後讀取其中的程式碼檔。若沒有新增或修改任何程式碼註解，立即回傳 {\"ok\":true}。有註解變更時，只檢查本次新增或修改的註解；未修改的既有註解與純刪除註解忽略。依 clean-comments skill 規則逐一判斷。若全部符合，回傳 {\"ok\":true}。若有違規，回傳 {\"ok\":false,\"reason\":\"列出每個 file:line、clean-comments Rule N、原註解、違規原因、建議改寫，要求主 Claude 修正後再結束任務\"}。不得修改檔案，只做檢查。Stop event context: $ARGUMENTS"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"{{NODE_EXE}}\" \"{{RUNTIME_DIR}}\\agent-workflow-hook.mjs\" git-guard --platform Claude",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
