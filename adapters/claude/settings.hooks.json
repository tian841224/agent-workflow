{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"{{NODE_EXE}}\" \"{{RUNTIME_DIR}}\\agent-workflow-hook.mjs\" session-start --platform Claude --state-root \"{{STATE_ROOT}}\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"{{NODE_EXE}}\" \"{{RUNTIME_DIR}}\\agent-workflow-hook.mjs\" session-cleanup --platform Claude --state-root \"{{STATE_ROOT}}\"",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"{{NODE_EXE}}\" \"{{RUNTIME_DIR}}\\agent-workflow-hook.mjs\" locale-context --platform Claude --state-root \"{{STATE_ROOT}}\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "\"{{NODE_EXE}}\" \"{{RUNTIME_DIR}}\\agent-workflow.mjs\" memory-context --platform Claude --state-root \"{{STATE_ROOT}}\" --auto --event UserPromptSubmit",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
