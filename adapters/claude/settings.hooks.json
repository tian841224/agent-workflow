{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"{{NODE_EXE}}\" \"{{RUNTIME_DIR}}\\agent-workflow.mjs\" memory-context --platform Claude --auto",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"{{NODE_EXE}}\" \"{{RUNTIME_DIR}}\\agent-workflow-hook.mjs\" locale-reminder --platform Claude",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"{{NODE_EXE}}\" \"{{RUNTIME_DIR}}\\agent-workflow-hook.mjs\" locale-lint --platform Claude",
            "timeout": 15
          },
          {
            "type": "agent",
            "timeout": 60,
            "prompt": "[agent-workflow managed: clean-comments]\n任務準備結束前執行 clean-comments 最終檢查。先讀取目前安裝的 clean-comments/SKILL.md 全文，再檢查本次工作樹的 git diff（包含 staged、unstaged 與新增未追蹤的程式碼檔案）。只檢查本次新增或修改的程式碼註解；未修改的既有註解與純刪除註解忽略。依 skill 規則逐一判斷。若全部符合，回傳 {\"ok\":true}。若有違規，回傳 {\"ok\":false,\"reason\":\"列出每個 file:line、clean-comments Rule N、原註解、違規原因、建議改寫；要求主 Claude 修正後再結束任務\"}。不得修改檔案，只做檢查。"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"{{NODE_EXE}}\" \"{{RUNTIME_DIR}}\\agent-workflow-hook.mjs\" git-guard --platform Claude",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
