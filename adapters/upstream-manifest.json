{
  "schema_version": 1,
  "integrations": {
    "ponytail": {
      "source": "https://github.com/DietrichGebert/ponytail",
      "ref": "main",
      "platforms": {
        "Claude": [
          ["plugin", "marketplace", "add", "$source"],
          ["plugin", "install", "ponytail@ponytail"]
        ],
        "Codex": [
          ["plugin", "marketplace", "add", "$source", "--ref", "$ref", "--json"],
          ["plugin", "add", "ponytail@ponytail", "--json"]
        ],
        "Antigravity": [
          ["plugin", "install", "$source"]
        ]
      }
    },
    "hallmark": {
      "source": "https://github.com/nutlope/hallmark",
      "ref": "main",
      "executables": {"Claude": "npx", "Codex": "npx", "Antigravity": "npx"},
      "platforms": {
        "Claude": [
          ["-y", "skills", "add", "$checkout", "--global", "--yes", "--agent", "claude-code"]
        ],
        "Codex": [
          ["-y", "skills", "add", "$checkout", "--global", "--yes", "--agent", "codex"]
        ],
        "Antigravity": [
          ["-y", "skills", "add", "$checkout", "--global", "--yes", "--agent", "antigravity"]
        ]
      }
    },
    "design-and-refine": {
      "source": "https://github.com/0xdesign/design-plugin",
      "ref": "main",
      "executables": {"Claude": "claude", "Codex": "npx", "Antigravity": "npx"},
      "platforms": {
        "Claude": [
          ["plugin", "marketplace", "add", "$source"],
          ["plugin", "install", "design-and-refine@design-plugins"]
        ],
        "Codex": [
          ["-y", "skills", "add", "$checkout", "--skill", "design-lab", "--global", "--yes", "--agent", "codex"]
        ],
        "Antigravity": [
          ["-y", "skills", "add", "$checkout", "--skill", "design-lab", "--global", "--yes", "--agent", "antigravity"]
        ]
      }
    }
  }
}
