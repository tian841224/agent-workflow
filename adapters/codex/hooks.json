{
  "description": "agent-workflow v4 minimal hooks",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$|^shell_command$",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"{{HOOKS_DIR}}\\git-guard.ps1\"",
            "timeout": 15,
            "statusMessage": "Checking Git safety"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"{{HOOKS_DIR}}\\quality-gate.ps1\"",
            "timeout": 15,
            "statusMessage": "Checking active task"
          }
        ]
      }
    ]
  }
}
