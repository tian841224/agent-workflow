{
  "description": "agent-workflow v4 minimal hooks",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$|^shell_command$",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"{{HOOKS_DIR}}\\git-guard.ps1\" -Platform Codex",
            "statusMessage": "Checking Git safety"
          }
        ]
      }
    ],
    "Stop": []
  }
}
