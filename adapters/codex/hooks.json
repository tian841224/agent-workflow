{
  "description": "agent-workflow v4 minimal hooks",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$|^shell_command$",
        "hooks": [
          {
            "type": "command",
            "command": "\"{{PYTHON_EXE}}\" -X utf8 -u \"{{RUNTIME_DIR}}\\agent_workflow.py\" git-guard --platform Codex",
            "statusMessage": "Checking Git safety"
          }
        ]
      }
    ],
    "Stop": []
  }
}
