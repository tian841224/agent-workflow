{
  "description": "claude-workflow lifecycle hooks adapted for Codex",
  "hooks": {
    "PostToolUse": [{ "matcher": "^Bash$|^apply_patch$", "hooks": [{ "type": "command", "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"{{HOOKS_DIR}}\\post-edit-check.ps1\"", "timeout": 30, "statusMessage": "Checking formatting" }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"{{HOOKS_DIR}}\\stop-check.ps1\"", "timeout": 15, "statusMessage": "Checking workflow completion" }, { "type": "command", "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"{{HOOKS_DIR}}\\knowhow-check.ps1\"", "timeout": 15, "statusMessage": "Checking know-how capture" }] }],
    "SessionStart": [{ "matcher": ".*", "hooks": [{ "type": "command", "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"{{HOOKS_DIR}}\\weekly-review-check.ps1\"", "timeout": 15, "statusMessage": "Checking weekly review" }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"{{HOOKS_DIR}}\\log-session.ps1\"", "timeout": 15, "statusMessage": "Logging session" }] }]
  }
}
