# agent-workflow Git safety policy.
prefix_rule(pattern=["git", "push", "--force"], decision="prompt", justification="Force push can destroy remote history.")
prefix_rule(pattern=["git", "push", "-f"], decision="prompt", justification="Force push can destroy remote history.")
prefix_rule(pattern=["git", "reset", "--hard"], decision="prompt", justification="Hard reset can destroy local work.")
prefix_rule(pattern=["git", "clean", "-fd"], decision="prompt", justification="Git clean can destroy untracked work.")
prefix_rule(pattern=["git", "branch", "-D"], decision="prompt", justification="Force deleting a branch can destroy recoverable work.")
prefix_rule(pattern=["git", "checkout", "--"], decision="prompt", justification="Discarding paths can destroy local work.")
prefix_rule(pattern=["git", "restore", "--worktree"], decision="prompt", justification="Restoring paths can destroy local work.")
prefix_rule(pattern=["git", "stash", "drop"], decision="prompt", justification="Dropping a stash can destroy recoverable work.")
prefix_rule(pattern=["git", "commit"], decision="prompt", justification="Ask before changing repository history.")
prefix_rule(pattern=["git", "push"], decision="prompt", justification="Ask before mutating the remote repository.")
prefix_rule(pattern=["git", "rebase"], decision="prompt", justification="Ask before rewriting repository history.")
prefix_rule(pattern=["git", "merge"], decision="prompt", justification="Ask before merging branch history.")
prefix_rule(pattern=["git", "reset"], decision="prompt", justification="Ask before moving HEAD or unstaging changes; --hard requires explicit user authorization.")
prefix_rule(pattern=["git", "cherry-pick"], decision="prompt", justification="Ask before replaying commits onto the current branch.")
prefix_rule(pattern=["git", "revert"], decision="prompt", justification="Ask before creating a revert commit.")
