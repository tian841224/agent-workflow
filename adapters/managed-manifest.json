{
  "schema_version": 4,
  "skills": {
    "workflow": {"required": true, "description": "workflow policy、task gate 與執行規則"},
    "codebase-design": {"required": true, "description": "模組介面、deep module 與 seam 設計"},
    "architecture-review": {"required": false, "description": "架構、跨層耦合與遷移風險審查"},
    "diagnosing-bugs": {"required": false, "description": "疑難除錯、重現與根因驗證"},
    "planning": {"required": true, "description": "需求釐清、方案比較與實作規劃"},
    "push-back": {"required": true, "description": "檢查方案是否過度複雜或偏離最小改動"},
    "learn": {"required": true, "description": "保存使用者確認的可重複使用結論"},
    "grill-me": {"required": true, "description": "針對模糊需求與高風險取捨進行逐題壓力測試"},
    "tdd": {"required": true, "description": "red → green → refactor 與測試設計"},
    "clean-comments": {"required": true, "description": "精簡且精確的程式碼註解"},
    "project-docs": {"required": false, "description": "docs/ 文件佈局、查詢與更新規範"},
    "distill": {"required": false, "description": "記憶提煉與 review 歸因改善"},
    "operational-verification": {"required": false, "description": "安裝、部署與外部整合的證據驗證"},
    "localization-tw": {"required": false, "description": "正體中文（臺灣）用語、語氣與標點"},
    "archify": {"required": false, "description": "建立可驗證、可互動的架構與流程圖"},
    "design-and-refine": {"required": false, "description": "探索、比較與收斂 UI 設計方向"},
    "adhd-comms": {"required": false, "description": "採取 Action-first 與高掃讀性溝通，結論先行、分點陳述、低認知負擔"},
    "humanizer": {"required": false, "description": "消除 AI 腔調與公式化套話，讓文字讀起來自然真實，保留事實與作者聲音"}
  },
