{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workflow.local/schemas/skill-draft.schema.json",
  "type": "object",
  "required": ["schema_version", "entries"],
  "properties": {
    "schema_version": { "const": 1 },
    "updated_at": { "type": "string" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status", "created_at", "updated_at"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
          "status": { "enum": ["draft", "promoted", "rejected"] },
          "cluster_id": { "type": "string" },
          "cluster_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "source_entries": { "type": "array", "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" } },
          "suppressed_sha": { "type": "array", "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" } },
          "draft_path": { "type": "string" },
          "skill_path": { "type": "string" },
          "note": { "type": "string" },
          "created_at": { "type": "string" },
          "updated_at": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
