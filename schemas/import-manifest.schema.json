{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workflow.local/schemas/import-manifest.schema.json",
  "type": "object",
  "required": ["schema_version", "run_id", "created_at", "updated_at", "state", "manifest_hash", "sources"],
  "properties": {
    "schema_version": { "const": 4 },
    "run_id": { "type": "string", "pattern": "^[0-9]{8}-[0-9]{6}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "state": { "enum": ["inventoried", "staged", "validated", "activated"] },
    "manifest_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_path", "origin", "category", "project_id", "project_root", "git_common_dir", "remote", "repo_fingerprint", "topic", "sha256", "bytes", "status", "reason", "snapshot_path", "destination", "relationships"],
        "properties": {
          "source_path": { "type": "string", "minLength": 1 },
          "origin": { "enum": ["global", "project-memory", "repository"] },
          "category": { "enum": ["global-knowledge", "project-knowledge", "history", "unresolved", "excluded"] },
          "project_id": { "type": "string" },
          "project_root": { "type": "string" },
          "git_common_dir": { "type": "string" },
          "remote": { "type": "string" },
          "repo_fingerprint": { "type": "string" },
          "topic": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 },
          "status": { "enum": ["pending", "imported", "deduplicated", "unresolved", "excluded"] },
          "reason": { "type": "string" },
          "snapshot_path": { "type": "string" },
          "destination": { "type": "string" },
          "relationships": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
