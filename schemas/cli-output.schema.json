{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workflow.local/schemas/cli-output.schema.json",
  "title": "agent-workflow CLI output shapes",
  "description": "The stdout object each contract-bearing command emits. Agent documents quote these field names, so they need a definition to be checked against — without one, a renamed output field drifts silently. $defs are keyed by command name.",
  "type": "object",
  "$defs": {
    "workflow-plan": {
      "type": "object",
      "required": ["required", "classification_incomplete", "step_classification_incomplete", "suggested", "requested", "selected", "order", "steps", "required_evidence", "plan_hash", "roles"],
      "properties": {
        "required": { "type": "array", "items": { "type": "string" } },
        "classification_incomplete": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "missing"],
            "properties": { "name": { "type": "string" }, "missing": { "type": "array", "items": { "type": "string" } } },
            "additionalProperties": false
          }
        },
        "step_classification_incomplete": {
          "description": "Steps of a selected capability whose `when` could not be decided from the declared facts. They are neither selected nor dropped; a managed_change task fails the gate until the fields named in `missing` are declared.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["capability", "id", "missing"],
            "properties": { "capability": { "type": "string" }, "id": { "type": "string" }, "missing": { "type": "array", "items": { "type": "string" } } },
            "additionalProperties": false
          }
        },
        "suggested": { "type": "array", "items": { "type": "object" } },
        "requested": { "type": "array", "items": { "type": "string" } },
        "selected": { "type": "array", "items": { "type": "string" } },
        "order": { "type": "array", "items": { "type": "string" } },
        "steps": { "type": "array", "items": { "type": "object" } },
        "required_evidence": { "type": "array", "items": { "type": "string" } },
        "plan_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "roles": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "execution-packet": {
      "oneOf": [
        {
          "type": "object",
          "required": ["task_id", "intent", "classification", "constraints", "workflow", "procedures", "required_evidence", "plan_hash", "plan_revision"],
          "properties": {
            "task_id": { "type": "string" },
            "intent": {
              "type": "object",
              "required": ["goal", "scope", "completion_criteria"],
              "properties": { "goal": { "type": "string" }, "scope": { "type": "string" }, "completion_criteria": { "type": "string" } },
              "additionalProperties": false
            },
            "classification": {
              "type": "object",
              "required": ["code_change", "managed_change", "workflow_mode", "task_type", "impact_scope", "impact_effect", "impact_confidence", "risk_flags", "workflow_facts"],
              "properties": {
                "code_change": { "type": "boolean" },
                "managed_change": { "type": "boolean" },
                "workflow_mode": { "type": "string" },
                "task_type": { "type": "string" },
                "impact_scope": { "type": "string" },
                "impact_effect": { "type": "string" },
                "impact_confidence": { "type": "string" },
                "risk_flags": { "type": "array", "items": { "type": "string" } },
                "workflow_facts": { "type": "object" }
              },
              "additionalProperties": false
            },
            "constraints": {
              "type": "object",
              "required": ["repo_root", "file_ownership"],
              "properties": {
                "repo_root": { "type": "string" },
                "file_ownership": { "type": "array", "items": { "type": "string" } },
                "subtask_role": { "type": "string" },
                "parent_task_id": { "type": "string" },
                "base_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
              },
              "additionalProperties": false
            },
            "workflow": {
              "type": "object",
              "required": ["required", "requested", "selected", "capabilities"],
              "properties": {
                "required": { "type": "array", "items": { "type": "string" } },
                "requested": { "type": "array", "items": { "type": "string" } },
                "selected": { "type": "array", "items": { "type": "string" } },
                "capabilities": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["name", "kind", "steps"],
                    "properties": {
                      "name": { "type": "string" },
                      "kind": { "type": "string" },
                      "steps": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": ["id", "title"],
                          "properties": { "id": { "type": "string" }, "title": { "type": "string" } },
                          "additionalProperties": false
                        }
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            },
            "procedures": { "type": "array", "items": { "type": "string" } },
            "required_evidence": { "type": "array", "items": { "type": "string" } },
            "plan_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "plan_revision": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["valid", "errors"],
          "properties": { "valid": { "const": false }, "errors": { "type": "array", "items": { "type": "string" } } },
          "additionalProperties": false
        }
      ]
    },
    "approve-intent": {
      "type": "object",
      "required": ["valid"],
      "properties": {
        "valid": { "type": "boolean" },
        "task": { "type": "string" },
        "intent_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "intent_approval": { "type": "object" },
        "errors": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "evidence-record": {
      "type": "object",
      "required": ["valid"],
      "properties": {
        "valid": { "type": "boolean" },
        "task": { "type": "string" },
        "id": { "type": "string" },
        "state_revision": { "type": "integer" },
        "errors": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "review-record": {
      "type": "object",
      "required": ["valid"],
      "properties": {
        "valid": { "type": "boolean" },
        "task": { "type": "string" },
        "id": { "type": "string" },
        "result": { "type": "string" },
        "reviewed_base": { "type": "string" },
        "reviewed_paths": { "type": "array", "items": { "type": "string" } },
        "delivery_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "state_revision": { "type": "integer" },
        "errors": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "task-gate": {
      "type": "object",
      "required": ["valid", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "task": { "type": "string" },
        "status": { "type": "string" },
        "compiled": { "type": "object" },
        "errors": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "next": {
      "description": "The same evaluation task-gate runs, re-presented as the next action: blockers categorized by the kind of work each demands, the still-unsatisfied evidence keys and roles, and one suggested command. An unreadable task falls back to the { valid, errors } shape.",
      "oneOf": [
        {
          "type": "object",
          "required": ["task", "blocking_reasons", "required_skills", "pending_evidence", "required_roles", "next_action"],
          "properties": {
            "task": { "type": "string" },
            "blocking_reasons": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["category", "detail"],
                "properties": {
                  "category": { "enum": ["classification", "evidence", "role", "intent", "lifecycle", "task"] },
                  "detail": { "type": "string" }
                },
                "additionalProperties": false
              }
            },
            "required_skills": { "type": "array", "items": { "type": "string" } },
            "pending_evidence": { "type": "array", "items": { "type": "string" } },
            "required_roles": { "type": "array", "items": { "type": "string" } },
            "next_action": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["valid", "errors"],
          "properties": { "valid": { "const": false }, "errors": { "type": "array", "items": { "type": "string" } } },
          "additionalProperties": false
        }
      ]
    },
    "project-doc-lookup": {
      "type": "object",
      "required": ["docs", "uncovered"],
      "properties": {
        "docs": { "type": "array", "items": { "$ref": "#/$defs/projectDocEntry" } },
        "uncovered": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "projectDocEntry": {
      "type": "object",
      "required": ["path", "doc_type", "covers"],
      "properties": {
        "path": { "type": "string" },
        "doc_type": { "type": "string" },
        "covers": { "type": "array", "items": { "type": "string" } },
        "matched_by": { "type": "array", "items": { "type": "string" } },
        "issues": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "review-cause-escalate": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["cause", "remedy_kind", "occurrences", "finding_ids", "task_ids", "paths"],
        "properties": {
          "cause": { "type": "string" },
          "remedy_kind": { "type": "string" },
          "occurrences": { "type": "integer" },
          "finding_ids": { "type": "array", "items": { "type": "string" } },
          "task_ids": { "type": "array", "items": { "type": "string" } },
          "paths": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "skill-draft-scan": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["cluster_id", "topic", "occurrences", "source_entries"],
        "properties": {
          "cluster_id": { "type": "string" },
          "topic": { "type": "string" },
          "occurrences": { "type": "integer" },
          "source_entries": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "worktree-fingerprint": {
      "type": "object",
      "required": ["workspace", "head", "dirty_sha256", "workspace_sha256"],
      "properties": {
        "workspace": { "type": "string" },
        "head": { "type": "string" },
        "dirty_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "workspace_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "reviewed_base": { "type": "string" },
        "reviewed_paths": { "type": "array", "items": { "type": "string" } },
        "reviewed_diff_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "verify": {
      "type": "object",
      "required": ["valid", "runtime_root", "node", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "runtime_root": { "type": "string" },
        "node": { "type": "string" },
        "errors": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "contract-lint": {
      "type": "object",
      "required": ["valid", "root", "scanned", "findings"],
      "properties": {
        "valid": { "type": "boolean" },
        "root": { "type": "string" },
        "scanned": { "type": "array", "items": { "type": "string" } },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file", "line", "rule", "detail"],
            "properties": { "file": { "type": "string" }, "line": { "type": "integer" }, "rule": { "type": "string" }, "detail": { "type": "string" } },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "policy-matrix": {
      "type": "object",
      "required": ["rows", "digests"],
      "properties": {
        "rows": { "type": "integer" },
        "digests": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
      },
      "additionalProperties": false
    }
  }
}
