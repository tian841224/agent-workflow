{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workflow.local/schemas/cli-output.schema.json",
  "title": "agent-workflow CLI output shapes",
  "description": "The stdout object each contract-bearing command emits. Agent documents quote these field names, so they need a definition to be checked against — without one, a renamed output field drifts silently. $defs are keyed by command name.",
  "type": "object",
  "$defs": {
    "execution-packet": {
      "oneOf": [
        {
          "type": "object",
          "required": ["task_id", "intent", "classification", "constraints", "workflow", "procedures", "required_evidence", "plan_hash", "plan_revision", "intent_hash"],
          "properties": {
            "task_id": { "type": "string" },
            "intent": {
              "type": "object",
              "required": ["goal", "scope", "completion_criteria"],
              "properties": { "goal": { "type": "string" }, "scope": { "type": "string" }, "completion_criteria": { "type": "string" } },
              "additionalProperties": false
            },
            "classification": {
              "type": "object",
              "required": ["code_change", "managed_change", "task_type", "impact_scope", "impact_effect", "impact_confidence", "risk_flags", "workflow_facts"],
              "properties": {
                "code_change": { "type": "boolean" },
                "managed_change": { "type": "boolean" },
                "task_type": { "type": "string" },
                "impact_scope": { "type": "string" },
                "impact_effect": { "type": "string" },
                "impact_confidence": { "type": "string" },
                "risk_flags": { "type": "array", "items": { "type": "string" } },
                "workflow_facts": { "type": "object" }
              },
              "additionalProperties": false
            },
            "constraints": {
              "type": "object",
              "required": ["repo_root", "file_ownership"],
              "properties": {
                "repo_root": { "type": "string" },
                "file_ownership": { "type": "array", "items": { "type": "string" } },
                "subtask_role": { "type": "string" },
                "parent_task_id": { "type": "string" },
                "base_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
              },
              "additionalProperties": false
            },
            "workflow": {
              "type": "object",
              "required": ["required", "requested", "selected", "capabilities", "exploration_profile"],
              "properties": {
                "required": { "type": "array", "items": { "type": "string" } },
                "requested": { "type": "array", "items": { "type": "string" } },
                "selected": { "type": "array", "items": { "type": "string" } },
                "exploration_profile": { "enum": ["focused", "expanded"] },
                "capabilities": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["name", "kind", "steps"],
                    "properties": {
                      "name": { "type": "string" },
                      "kind": { "type": "string" },
                      "steps": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": ["id", "title"],
                          "properties": { "id": { "type": "string" }, "title": { "type": "string" } },
                          "additionalProperties": false
                        }
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            },
            "procedures": { "type": "array", "items": { "type": "string" } },
            "required_evidence": { "type": "array", "items": { "type": "string" } },
            "plan_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "plan_revision": { "type": "integer", "minimum": 1 },
            "intent_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["valid", "errors"],
          "properties": { "valid": { "const": false }, "errors": { "type": "array", "items": { "type": "string" } } },
          "additionalProperties": false
        }
      ]
    },
    "approve-intent": {
      "type": "object",
      "required": ["valid"],
      "properties": {
        "valid": { "type": "boolean" },
        "task": { "type": "string" },
        "intent_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "intent_approval": { "type": "object" },
        "next": { "$ref": "#/$defs/nextActions" },
        "errors": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "evidence-run": {
      "description": "valid is true only when the command exited 0; a failing run is still recorded, and the gate treats it as not passed.",
      "type": "object",
      "required": ["valid"],
      "properties": {
        "valid": { "type": "boolean" },
        "task": { "type": "string" },
        "id": { "type": "string" },
        "ids": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string" } },
        "exit_code": { "type": "integer" },
        "state_revision": { "type": "integer" },
        "next": { "$ref": "#/$defs/nextActions" },
        "errors": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "review-record": {
      "type": "object",
      "required": ["valid"],
      "properties": {
        "valid": { "type": "boolean" },
        "task": { "type": "string" },
        "id": { "type": "string" },
        "result": { "type": "string" },
        "reviewed_base": { "type": "string" },
        "reviewed_paths": { "type": "array", "items": { "type": "string" } },
        "delivery_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "state_revision": { "type": "integer" },
        "review_cause": { "type": "object" },
        "next": { "$ref": "#/$defs/nextActions" },
        "errors": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "task-gate": {
      "type": "object",
      "required": ["valid", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "task": { "type": "string" },
        "status": { "type": "string" },
        "compiled": { "type": "object" },
        "errors": { "type": "array", "items": { "type": "string" } },
        "next": { "$ref": "#/$defs/nextActions" }
      },
      "additionalProperties": false
    },
    "project-doc-lookup": {
      "type": "object",
      "required": ["docs", "overview_candidates", "uncovered"],
      "properties": {
        "docs": { "type": "array", "items": { "$ref": "#/$defs/projectDocEntry" } },
        "overview_candidates": { "type": "array", "items": { "$ref": "#/$defs/projectDocOverviewCandidate" } },
        "uncovered": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "project-doc-remember": {
      "oneOf": [
        {
          "type": "object",
          "required": ["valid", "task", "state_revision", "remembered"],
          "properties": {
            "valid": { "const": true },
            "task": { "type": "string" },
            "state_revision": { "type": "integer", "minimum": 0 },
            "remembered": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["path", "content_sha256"],
                "properties": {
                  "path": { "type": "string" },
                  "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["valid", "errors"],
          "properties": { "valid": { "const": false }, "errors": { "type": "array", "items": { "type": "string" } } },
          "additionalProperties": false
        }
      ]
    },
    "projectDocEntry": {
      "type": "object",
      "required": ["path", "doc_type", "covers", "content_sha256"],
      "properties": {
        "path": { "type": "string" },
        "doc_type": { "type": "string" },
        "covers": { "type": "array", "items": { "type": "string" } },
        "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "matched_by": { "type": "array", "items": { "type": "string" } },
        "digest_status": { "enum": ["untracked", "unread", "digest_missing", "reusable", "stale"] },
        "issues": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "review-cause-escalate": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["cause", "remedy_kind", "occurrences", "finding_ids", "task_ids", "paths"],
        "properties": {
          "cause": { "type": "string" },
          "remedy_kind": { "type": "string" },
          "occurrences": { "type": "integer" },
          "finding_ids": { "type": "array", "items": { "type": "string" } },
          "task_ids": { "type": "array", "items": { "type": "string" } },
          "paths": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "projectDocOverviewCandidate": {
      "type": "object",
      "required": ["path", "doc_type", "content_sha256", "reason"],
      "properties": {
        "path": { "type": "string" },
        "doc_type": { "type": "string" },
        "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "reason": { "type": "string" },
        "digest_status": { "enum": ["untracked", "unread", "digest_missing", "reusable", "stale"] }
      },
      "additionalProperties": false
    },
    "skill-draft-scan": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["cluster_id", "topic", "occurrences", "source_entries"],
        "properties": {
          "cluster_id": { "type": "string" },
          "topic": { "type": "string" },
          "occurrences": { "type": "integer" },
          "source_entries": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "pre-review": {
      "description": "Opens a review round: the diff check, the workspace fingerprint review-record binds the resulting PASS to and, with --task-path, the round's review brief.",
      "type": "object",
      "required": ["valid", "check", "errors", "workspace_sha256"],
      "properties": {
        "valid": { "type": "boolean" },
        "check": { "type": "string" },
        "errors": { "type": "array", "items": { "type": "string" } },
        "workspace_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "review": { "$ref": "#/$defs/reviewBrief" }
      },
      "additionalProperties": false
    },
    "worktree-fingerprint": {
      "type": "object",
      "required": ["workspace", "head", "dirty_sha256", "workspace_sha256"],
      "properties": {
        "workspace": { "type": "string" },
        "head": { "type": "string" },
        "dirty_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "workspace_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "reviewed_base": { "type": "string" },
        "reviewed_paths": { "type": "array", "items": { "type": "string" } },
        "reviewed_diff_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "orchestrate": {
      "description": "Protocol 3 orchestration responses, plus the read-only view of a retired protocol 2 state. Assess adds worthwhile, recommendation and reasons; Prepare adds dispatch; every protocol 3 action returns next.",
      "type": "object",
      "properties": {
        "protocol": { "type": "integer" },
        "action": { "type": "string" },
        "batch": { "type": "object" },
        "valid": { "type": "boolean" },
        "eligible": { "type": "boolean" },
        "worthwhile": { "type": "boolean" },
        "recommendation": { "enum": ["parallel", "sequential"] },
        "reasons": { "type": "array", "items": { "type": "string" } },
        "dispatch": { "type": "array", "items": { "type": "object", "properties": { "worker_id": { "type": "string" }, "packet_path": { "type": "string" }, "worktree": { "type": "string" }, "result_path": { "type": "string" } }, "additionalProperties": false } },
        "worker_id": { "type": "string" },
        "artifact_hash": { "type": "string" },
        "rejected_reason": { "type": "string" },
        "repo_root": { "type": "string" },
        "worker_count": { "type": "integer" },
        "errors": { "type": "array", "items": { "type": "string" } },
        "recoverable": { "type": "boolean" },
        "next": { "$ref": "#/$defs/nextActions" }
      },
      "additionalProperties": true
    },
    "worker-check": {
      "type": "object",
      "required": ["valid", "assignment", "repo_root", "file_ownership"],
      "properties": {
        "valid": { "const": true },
        "assignment": { "type": "string" },
        "repo_root": { "type": "string" },
        "file_ownership": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "worker-exec": {
      "type": "object",
      "required": ["valid", "assignment", "repo_root", "command", "cwd", "exit_code", "stdout", "stderr", "output_digest"],
      "properties": {
        "valid": { "type": "boolean" },
        "assignment": { "type": "string" },
        "repo_root": { "type": "string" },
        "command": { "type": "array", "items": { "type": "string" } },
        "cwd": { "type": "string" },
        "exit_code": { "type": "integer" },
        "acceptance": { "description": "Assigned acceptance cases this run verifies; recorded as a receipt Collect reads.", "type": "array", "items": { "type": "string" } },
        "stdout": { "type": "string" },
        "stderr": { "type": "string" },
        "output_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "verify": {
      "type": "object",
      "required": ["valid", "runtime_root", "node", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "runtime_root": { "type": "string" },
        "node": { "type": "string" },
        "errors": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "contract-lint": {
      "type": "object",
      "required": ["valid", "root", "scanned", "findings"],
      "properties": {
        "valid": { "type": "boolean" },
        "root": { "type": "string" },
        "scanned": { "type": "array", "items": { "type": "string" } },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file", "line", "rule", "detail"],
            "properties": { "file": { "type": "string" }, "line": { "type": "integer" }, "rule": { "type": "string" }, "detail": { "type": "string" } },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "policy-matrix": {
      "type": "object",
      "required": ["rows", "digests"],
      "properties": {
        "rows": { "type": "integer" },
        "digests": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
      },
      "additionalProperties": false
    },
    "reviewBrief": {
      "description": "One review round's scope. scope is full on the first round and delta afterwards, covering only paths whose content changed since the previous review.",
      "type": "object",
      "required": ["round", "scope", "paths"],
      "properties": {
        "round": { "type": "integer", "minimum": 1 },
        "scope": { "enum": ["full", "delta"] },
        "base": { "type": "string" },
        "paths": { "type": "array", "items": { "type": "string" } },
        "previous": { "type": "object", "properties": { "result": { "type": "string" }, "summary": { "type": "string" } }, "additionalProperties": false },
        "acceptance": { "type": "array", "items": { "type": "object" } },
        "checklist": { "type": "array", "items": { "$ref": "#/$defs/planStep" } },
        "risk_flags": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "task-init": {
      "description": "Creates the task and returns what development needs up front: the compiled plan, readiness, the --paths context, whether a parallel split is worth considering, and next.",
      "type": "object",
      "required": ["valid"],
      "properties": {
        "valid": { "type": "boolean" },
        "task": { "type": "string" },
        "plan": { "$ref": "#/$defs/plan" },
        "procedures": { "type": "array", "items": { "type": "string" } },
        "readiness": { "type": "object" },
        "parallel_hint": { "$ref": "#/$defs/parallelHint" },
        "context": { "$ref": "#/$defs/taskContext" },
        "next": { "$ref": "#/$defs/nextActions" },
        "errors": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "plan": {
      "type": "object",
      "properties": {
        "required": { "type": "array", "items": { "type": "string" } },
        "classification_incomplete": { "type": "array", "items": { "type": "object" } },
        "suggested": { "type": "array", "items": { "type": "object" } },
        "requested": { "type": "array", "items": { "type": "string" } },
        "selected": { "type": "array", "items": { "type": "string" } },
        "exploration_profile": { "enum": ["focused", "expanded"] },
        "required_evidence": { "type": "array", "items": { "type": "string" } },
        "proofs": { "description": "Runtime proofs the gate demands; record each with evidence-run.", "type": "array", "items": { "$ref": "#/$defs/planStep" } },
        "checklist": { "description": "Analysis steps that steer the work and the reviewer brief; never gate items.", "type": "array", "items": { "$ref": "#/$defs/planStep" } },
        "plan_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "roles": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "taskContext": {
      "description": "Project docs, memory entries and closed tasks related to the paths given to task-init --paths; doc_gap names paths no project doc covers.",
      "type": "object",
      "properties": {
        "paths": { "type": "array", "items": { "type": "string" } },
        "docs": { "type": "object" },
        "memory": { "type": "array", "items": { "type": "object" } },
        "history": { "type": "array", "items": { "type": "object" } },
        "doc_gap": { "type": "string" }
      },
      "additionalProperties": false
    },
    "close-task": {
      "type": "object",
      "required": ["valid"],
      "properties": {
        "valid": { "type": "boolean" },
        "closed": { "type": "string" },
        "task": { "type": "string" },
        "status": { "type": "string" },
        "compiled": { "type": "object" },
        "errors": { "type": "array", "items": { "type": "string" } },
        "next": { "$ref": "#/$defs/nextActions" }
      },
      "additionalProperties": false
    },
    "nextActions": {
      "description": "The commands that close the task's remaining gate items, in workflow order.",
      "type": "array",
      "items": { "type": "object", "required": ["command", "why"], "properties": { "command": { "type": "string" }, "why": { "type": "string" } }, "additionalProperties": false }
    },
    "planStep": {
      "type": "object",
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "undecided_by": { "description": "Classification fields still undeclared; declaring them with task-write settles whether this step applies.", "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "parallelHint": {
      "description": "First filter for a parallel split, returned for managed code-change tasks. candidate false comes with the reasons; the split plan itself is judged by orchestrate Assess.",
      "type": "object",
      "required": ["candidate", "reasons"],
      "properties": {
        "candidate": { "type": "boolean" },
        "reasons": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  }
}
