{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workflow.local/schemas/task.schema.json",
  "title": "agent-workflow task state (v4)",
  "description": "The single machine contract for task.json. Every runtime write path validates against this file before the state lands on disk; the sibling task.md holds human intent only.",
  "type": "object",
  "required": ["schema_version", "id", "project_id", "worktree_id", "code_change", "managed_change", "risk_flags", "created_at", "updated_at", "lifecycle", "evidence", "waivers", "state_revision", "plan_revision"],
  "properties": {
    "schema_version": { "const": 4 },
    "id": { "type": "string", "pattern": "^[0-9]{8}-[0-9]{6}-[a-z0-9-]+$" },
    "project_id": { "type": "string", "pattern": "^[a-f0-9]{16}$" },
    "worktree_id": { "type": "string", "pattern": "^[a-f0-9]{16}$" },
    "state_revision": { "type": "integer", "minimum": 1 },
    "plan_revision": { "type": "integer", "minimum": 1 },
    "code_change": { "type": "boolean", "description": "Whether this task modifies application source code. Descriptive only — does not decide whether the managed workflow applies; see managed_change." },
    "managed_change": { "type": "boolean", "description": "Whether this task enters the managed workflow. True when the change can affect executable behavior, data, contracts, security, deployment/runtime results, delivery behavior, or verification integrity. False bypasses the managed workflow regardless of code_change. Safe test-only additions, assertion strengthening, and test refactors that do not weaken verification may remain false." },
    "workflow_mode": { "enum": ["main", "legacy"] },
    "task_type": { "enum": ["fix", "feature", "refactor", "chore", "schema", "migration", "config", "docs", "investigation", "read_only"] },
    "model_profile": { "enum": ["cheap_read", "deep_read"] },
    "impact_scope": { "enum": ["file", "module", "multi_module", "cross_project"] },
    "impact_effect": { "enum": ["none", "local_behavior", "shared_behavior", "schema", "data", "contract", "destructive"] },
    "impact_confidence": { "enum": ["high", "medium", "low"] },
    "workflow_request": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "workflow_facts": { "$ref": "#/$defs/workflowFacts" },
    "workflow_decision": { "type": "string", "minLength": 2 },
    "risk_flags": { "type": "array", "uniqueItems": true, "items": { "enum": ["behavior_change", "ui", "data_write", "contract", "schema", "financial", "authorization", "cross_feature", "migration", "irreversible", "unclear_requirements", "test_integrity", "security", "operational"] } },
    "independence": { "enum": ["native", "degraded"] },
    "subtask_role": { "enum": ["coordinator", "worker"] },
    "parent_task_id": { "type": "string", "pattern": "^[0-9]{8}-[0-9]{6}-[a-z0-9-]+$" },
    "file_ownership": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^(?!\\./)[^\\\\,\\[\\]]+$" } },
    "base_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "delivery_status": { "enum": ["pending", "applied", "merged", "rejected", "skipped"] },
    "integration_status": { "enum": ["pending", "conflicted", "applied", "abandoned"] },
    "intent_approval": {
      "description": "Written only by `agent-workflow approve-intent`; intent_hash covers only task.md's Goal/Scope/Completion criteria sections, not the whole file, so unrelated edits (typos, evidence prose) do not invalidate it.",
      "type": ["object", "null"],
      "required": ["intent_hash", "confirmed_at", "confirmed_by", "source"],
      "properties": {
        "intent_hash": { "$ref": "#/$defs/sha256" },
        "confirmed_at": { "type": "string", "format": "date-time" },
        "confirmed_by": { "type": "string", "minLength": 1 },
        "source": { "enum": ["user", "cli-attestation"] }
      },
      "additionalProperties": false
    },
    "lifecycle": {
      "type": "object",
      "required": ["status", "transitions"],
      "properties": {
        "status": { "enum": ["in_progress", "paused", "blocked", "superseded", "closed"] },
        "transitions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/transition" } },
        "stop_reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
    "waivers": { "type": "array", "items": { "$ref": "#/$defs/waiver" } },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "workflowFacts": {
      "type": "object",
      "description": "Declared facts that steer step selection inside an already-selected capability. Names are the closed set referenced by schemas/workflow-policy.json; an undeclared fact stays unknown and keeps its step.",
      "propertyNames": {
        "enum": [
          "changes_module_interface", "data_transform", "debug_requested", "destructive_operation",
          "flaky_failure", "has_consumer", "improves_testability", "introduces_adapter",
          "performance_anomaly", "schema_constraint_change", "schema_operation", "testable_behavior_change",
          "test_deleted", "test_skipped", "assertion_weakened", "snapshot_mass_change"
        ]
      },
      "additionalProperties": { "type": ["boolean", "string", "number"] }
    },
    "transition": {
      "type": "object",
      "required": ["at", "action", "from", "to", "actor"],
      "properties": {
        "at": { "type": "string", "format": "date-time" },
        "action": { "enum": ["create", "migrate", "pause", "block", "resume", "supersede", "waive", "close"] },
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "actor": { "type": "string", "minLength": 1 },
        "confirmed_by_user": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "waiver": {
      "type": "object",
      "required": ["at", "actor", "confirmed_by_user", "requirement_id", "plan_hash", "intent_hash"],
      "properties": {
        "at": { "type": "string", "format": "date-time" },
        "actor": { "type": "string", "minLength": 1 },
        "confirmed_by_user": { "type": "string", "minLength": 1 },
        "requirement_id": { "type": "string", "minLength": 1 },
        "plan_hash": { "$ref": "#/$defs/sha256" },
        "intent_hash": { "$ref": "#/$defs/sha256" },
        "stale": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "evidence": {
      "oneOf": [
        { "$ref": "#/$defs/roleEvidence" },
        { "$ref": "#/$defs/stepEvidence" },
        { "$ref": "#/$defs/legacyEvidence" }
      ]
    },
    "roleEvidence": {
      "type": "object",
      "description": "One role capability's result, written only by `agent-workflow review-record`. Freshness is scoped to the diff that was actually reviewed, not to the whole workspace: reviewed_base + reviewed_paths + reviewed_diff_sha256 are runtime-computed and the gate recomputes them. delivery_hash additionally fingerprints the task's whole delivery (every changed path from base_commit), for audit use alongside the more precise reviewed_* scoping.",
      "required": ["kind", "id", "result", "at", "plan_hash", "intent_hash", "plan_revision", "reviewed_base", "reviewed_paths", "reviewed_diff_sha256", "delivery_hash"],
      "properties": {
        "kind": { "const": "role" },
        "id": { "type": "string", "pattern": "^role\\.[a-z0-9_]+$" },
        "result": { "enum": ["pass", "fail"] },
        "at": { "type": "string", "format": "date-time" },
        "plan_hash": { "$ref": "#/$defs/sha256" },
        "plan_revision": { "type": "integer", "minimum": 1 },
        "reviewed_base": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "reviewed_paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "reviewed_diff_sha256": { "$ref": "#/$defs/sha256" },
        "delivery_hash": { "$ref": "#/$defs/sha256" },
        "intent_hash": { "$ref": "#/$defs/sha256" },
        "summary": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "stepEvidence": {
      "type": "object",
      "description": "One evidence-capability step's result, keyed as <capability>.<step id> to match compileWorkflowPlan's required_evidence, written only by `agent-workflow evidence-record`/`evidence-run`. status: recorded means the agent has completed and recorded this analysis — it is not a cryptographic verification claim. plan_revision (like role evidence's) guards against plan_hash's own reversibility: a classification round-trip can restore an identical plan_hash, so the gate also requires plan_revision to match the task's current one.",
      "required": ["kind", "id", "status", "at", "plan_hash", "intent_hash", "plan_revision", "summary"],
      "allOf": [
        {
          "if": { "properties": { "evidence_kind": { "const": "analysis" } }, "required": ["evidence_kind"] },
          "then": { "not": { "anyOf": [
            { "required": ["command"] }, { "required": ["cwd"] }, { "required": ["exit_code"] },
            { "required": ["duration_ms"] }, { "required": ["started_at"] }, { "required": ["output_digest"] }
          ] } }
        },
        {
          "if": { "properties": { "evidence_kind": { "const": "execution" } }, "required": ["evidence_kind"] },
          "then": { "required": ["command", "cwd", "exit_code", "duration_ms", "started_at", "output_digest"] }
        }
      ],
      "properties": {
        "kind": { "const": "step" },
        "trust_level": { "enum": ["attested", "runtime"], "description": "attested: the agent reported this itself. runtime: `agent-workflow evidence-run` observed the command it records." },
        "id": { "type": "string", "pattern": "^[a-z_]+\\.[A-Za-z0-9]+$" },
        "status": { "const": "recorded" },
        "at": { "type": "string", "format": "date-time" },
        "plan_hash": { "$ref": "#/$defs/sha256" },
        "plan_revision": { "type": "integer", "minimum": 1 },
        "intent_hash": { "$ref": "#/$defs/sha256" },
        "actor": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "evidence_kind": { "enum": ["analysis", "execution"] },
        "command": { "type": "string", "minLength": 1 },
        "cwd": { "type": "string", "minLength": 1 },
        "exit_code": { "type": "integer" },
        "started_at": { "type": "string", "format": "date-time" },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "output_digest": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "legacyEvidence": {
      "type": "object",
      "description": "Written only by migrate-state for an imported/pre-v4 task.md; the gate always rejects it until a new evidence-record/review-record replaces it.",
      "required": ["kind", "status"],
      "properties": {
        "kind": { "const": "legacy-unverified" },
        "status": { "const": "needs_reverification" },
        "note": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "x_agent_workflow": {
    "freeze_required": ["contract", "schema", "financial", "authorization", "cross_feature", "migration", "irreversible", "unclear_requirements"]
  }
}
