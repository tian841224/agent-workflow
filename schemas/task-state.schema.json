{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agent-workflow task state",
  "type": "object",
  "required": ["schema_version", "id", "lifecycle", "evidence"],
  "properties": {
    "schema_version": {"const": 2},
    "id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string"},
    "worktree_id": {"type": "string"},
    "code_change": {"type": "boolean"},
    "workflow_mode": {"type": "string"},
    "task_type": {"type": "string"},
    "change_kind": {"type": "string"},
    "risk_flags": {"type": "array", "items": {"type": "string"}},
    "impact_scope": {"type": "string"},
    "impact_effect": {"type": "string"},
    "impact_confidence": {"type": "string"},
    "complexity_hint": {"type": "array", "items": {"type": "string"}},
    "workflow_request": {"type": "array", "items": {"type": "string"}},
    "workflow_facts": {"type": "object"},
    "workflow_decision": {"type": "string"},
    "model_profile": {"type": "string"},
    "independence": {"type": "string"},
    "lifecycle": {
      "type": "object",
      "required": ["status", "transitions"],
      "properties": {
        "status": {"enum": ["in_progress", "frozen", "paused", "blocked", "superseded", "closed"]},
        "transitions": {"type": "array", "minItems": 1},
        "frozen_at": {"type": "string"},
        "stop_reason": {"type": "string"}
      }
    },
    "compiled": {
      "type": "object",
      "properties": {
        "policy_version": {"type": "number"},
        "requirements_hash": {"type": "string"},
        "order": {"type": "array", "items": {"type": "string"}},
        "required_evidence": {"type": "array", "items": {"type": "string"}}
      }
    },
    "evidence": {"type": "array"},
    "waivers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "at": {"type": "string"},
          "actor": {"type": "string"},
          "confirmed_by_user": {"type": "string"},
          "requirement_id": {"type": "string"}
        }
      }
    }
  },
  "additionalProperties": true
}
