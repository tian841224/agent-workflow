{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agent-workflow task state",
  "type": "object",
  "required": ["schema_version", "id", "intent", "lifecycle", "evidence"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "intent": {"type": "string", "minLength": 1},
    "lifecycle": {
      "type": "object",
      "required": ["status", "transitions"],
      "properties": {
        "status": {"enum": ["in_progress", "frozen", "paused", "blocked", "superseded", "closed"]},
        "transitions": {"type": "array", "minItems": 1}
      }
    },
    "evidence": {"type": "array"},
    "waivers": {"type": "array"},
    "required_evidence": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
