{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workflow.local/schemas/orchestration.schema.json",
  "title": "agent-workflow orchestration state",
  "description": "Protocol 3 multi-worker orchestration state. The retired version 2 phase tracker is no longer written.",
  "oneOf": [
    { "$ref": "#/$defs/v3" }
  ],
  "$defs": {
    "split-plan": {
      "description": "The split plan a coordinator passes to orchestrate --plan-path (Assess, Prepare, Retry).",
      "type": "object",
      "required": ["workers"],
      "properties": {
        "parent_task_path": { "type": "string" },
        "repo_root": { "type": "string" },
        "max_workers": { "type": "integer", "minimum": 2, "default": 3 },
        "min_files_per_worker": { "type": "integer", "minimum": 1, "default": 3 },
        "shared_files": { "type": "array", "items": { "type": "string" } },
        "coordinator_acceptance": { "type": "array", "items": { "type": "string" } },
        "has_order_dependency": { "type": "boolean" },
        "shared_persistent_state": { "type": "boolean" },
        "workers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "goal", "file_ownership"],
            "properties": {
              "id": { "type": "string" }, "title": { "type": "string" }, "goal": { "type": "string" }, "scope": { "type": "string" },
              "completion_criteria": { "type": "string" },
              "acceptance": { "type": "array", "items": { "type": "string" } },
              "file_ownership": { "type": "array", "items": { "type": "string" } },
              "planned_files": { "type": "array", "items": { "type": "string" } },
              "task_path": { "type": "string" },
              "classification": { "type": "object" }
            }
          }
        }
      }
    },
    "assignment": {
      "description": "The assignment Prepare/Retry writes into each worker's execution-packet.json.",
      "type": "object",
      "properties": {
        "worker_id": { "type": "string" }, "attempt": { "type": "integer" }, "goal": { "type": "string" }, "completion_criteria": { "type": "string" },
        "acceptance": { "type": "array", "items": { "type": "object", "properties": { "id": { "type": "string" }, "title": { "type": "string" }, "given": { "type": "string" }, "when": { "type": "string" }, "then": { "type": "string" }, "command": { "type": "string" }, "verify": { "type": "string" } } } },
        "worktree": { "type": "string" }, "file_ownership": { "type": "array", "items": { "type": "string" } }, "planned_files": { "type": "array", "items": { "type": "string" } },
        "shared_files_read_only": { "type": "array", "items": { "type": "string" } },
        "result_path": { "type": "string" }, "run_command": { "type": "string" }
      }
    },
    "worker-result": {
      "description": "The result file a worker writes at assignment.result_path; Collect reads it.",
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["completed", "blocked", "failed", "cancelled"] },
        "run_id": { "type": "string" }, "attempt": { "type": "integer" },
        "modified_paths": { "type": "array", "items": { "type": "string" } },
        "acceptance": { "type": "array", "items": { "type": "object" } },
        "unresolved": { "type": "array", "items": { "type": "string" } },
        "ownership_request": { "type": "object", "properties": { "path": { "type": "string" }, "reason": { "type": "string" }, "blocks": { "type": "string" } } }
      }
    },
    "artifact": {
      "type": "object",
      "required": ["path", "kind", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["file", "delete"] },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "size": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "worker": {
      "type": "object",
      "required": ["id", "title", "task_id", "task_path", "packet_path", "worktree", "file_ownership", "attempt", "status", "artifact_status"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "title": { "type": "string", "minLength": 1 },
        "task_id": { "type": "string", "minLength": 1 },
        "task_path": { "type": "string", "minLength": 1 },
        "packet_path": { "type": "string", "minLength": 1 },
        "worktree": { "type": "string", "minLength": 1 },
        "file_ownership": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "attempt": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["prepared", "bound", "running", "completed", "blocked", "failed", "cancelled"] },
        "artifact_status": { "enum": ["uncollected", "collected", "rejected"] },
        "host": { "type": "object" },
        "result": { "type": "object" },
        "artifact_root": { "type": "string" },
        "artifact": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
        "artifact_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "goal": { "type": "string" },
        "acceptance": { "description": "Parent acceptance case ids this worker must make pass.", "type": "array", "items": { "type": "string", "pattern": "^AC\\d+$" } },
        "planned_files": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "acceptance_results": { "description": "Latest worker-exec receipt per assigned acceptance case, copied at Collect. Feedback for the coordinator only; the parent re-runs every case after Apply.", "type": "object", "additionalProperties": { "type": "object" } },
        "rejected_reason": { "type": "string" }
      },
      "additionalProperties": false
    },
    "journal-entry": {
      "type": "object",
      "required": ["at", "action"],
      "properties": {
        "at": { "type": "string", "format": "date-time" },
        "action": { "type": "string", "minLength": 1 },
        "status": { "type": "string" },
        "detail": { "type": "string" },
        "worker_id": { "type": "string" },
        "run_id": { "type": "string" },
        "attempt": { "type": "integer", "minimum": 1 },
        "artifact_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "fingerprint": { "type": "string" }
      },
      "additionalProperties": false
    },
    "v3": {
      "type": "object",
      "required": ["schema_version", "protocol", "id", "experimental", "phase", "state_revision", "created_at", "updated_at", "parent", "workers", "integration", "host_bindings", "journal", "history"],
      "properties": {
        "schema_version": { "const": 3 },
        "protocol": { "const": 3 },
        "id": { "type": "string", "minLength": 1 },
        "experimental": { "const": false },
        "phase": { "enum": ["planned", "prepared", "executing", "collecting", "integrating", "applied", "cleaning", "cleaned", "failed", "cancelled"] },
        "state_revision": { "type": "integer", "minimum": 1 },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "parent": {
          "type": "object",
          "required": ["task_path", "task_id", "repo_root", "snapshot_commit", "workspace_fingerprint"],
          "properties": {
            "task_path": { "type": "string" },
            "task_id": { "type": "string" },
            "repo_root": { "type": "string", "minLength": 1 },
            "snapshot_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
            "snapshot_workspace_fingerprint": { "type": "string", "minLength": 1 },
            "workspace_fingerprint": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "workers": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/worker" } },
        "plan": {
          "type": "object",
          "properties": {
            "shared_files": { "description": "Coordinator-owned files every worker reads but none may write.", "type": "array", "items": { "type": "string" } },
            "coordinator_acceptance": { "description": "Cross-worker acceptance cases the parent runs after Apply.", "type": "array", "items": { "type": "string", "pattern": "^AC\\d+$" } }
          },
          "additionalProperties": false
        },
        "integration": {
          "type": "object",
          "required": ["status", "root"],
          "properties": {
            "status": { "enum": ["pending", "integrated", "applied"] },
            "root": { "type": "string", "minLength": 1 },
            "paths": { "type": "array", "items": { "type": "string" } },
            "fingerprint": { "type": "string" },
            "applied_paths": { "type": "array", "items": { "type": "string" } },
            "applied_fingerprint": { "type": "string" }
          },
          "additionalProperties": false
        },
        "host_bindings": { "type": "array", "items": { "type": "object" } },
        "journal": { "type": "array", "items": { "$ref": "#/$defs/journal-entry" } },
        "history": { "type": "array" }
      },
      "additionalProperties": false
    }
  }
}
